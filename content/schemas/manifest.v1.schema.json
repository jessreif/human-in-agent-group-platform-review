          "type": "string"
        }
      },
      "required": [
        "speaker",
        "answered_rule"
      ],
      "title": "CrosstalkPolicy",
      "type": "object"
    },
    "DecisionRef": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "D01",
            "D02",
            "D03",
            "D04",
            "D05",
            "D06",
            "D07",
            "D08",
            "D09",
            "D10",
            "D11",
            "D12",
            "D13",
            "D14"
          ],
          "title": "Decision",
          "type": "string"
        },
        "status": {
          "enum": [
            "unresolved",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "status"

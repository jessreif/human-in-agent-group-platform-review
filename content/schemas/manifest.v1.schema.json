            "approved",
            "unresolved_placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "unassigned",
                  "assigned",
                  "assigned_own"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targets"
        },
        "times_active_s": {
          "items": {
            "type": "integer"

        "peer_ratings": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "post_task": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "training": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "consent",
        "training",
        "confidence",
        "peer_ratings",
        "post_task",
        "debrief"
      ],
      "title": "Instruments",
      "type": "object"
    },
    "Interaction": {
      "additionalProperties": false,
      "description": "UX round 3 (FR-1) feature flag: how the participant asks teammates and the\nassistant. ``structured_and_nl`` offers the per-crate request controls alongside\nfree text; ``nl_only`` removes them — ``structured_seeking`` may not open in any\nphase and assistant asks must carry typed text. Arm-invariant by construction (it\nis not under ``condition_set``), so both arms of a profile always share it.",
      "properties": {
        "mode": {
          "enum": [
            "structured_and_nl",
            "nl_only"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Interaction",
      "type": "object"
    },
    "Lognormal": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "lognormal",
          "title": "Family",
          "type": "string"
        },
        "location": {
          "enum": [
            "median",
            "mean"
          ],
          "title": "Location",
          "type": "string"
        },
        "location_s": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Location S",
          "type": "number"
        },
        "sigma": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Sigma",
          "type": "number"
        },
        "truncation": {
          "$ref": "#/$defs/Truncation"
        }
      },
      "required": [
        "family",
        "location",
        "location_s",
        "sigma",
        "truncation"
      ],
      "title": "Lognormal",
      "type": "object"
    },
    "Outcomes": {
      "additionalProperties": false,
      "properties": {
        "completion_statuses": {
          "items": {
            "enum": [

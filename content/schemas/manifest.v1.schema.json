      "title": "DecisionRef",
      "type": "object"
    },
    "EvaluationArm": {
      "additionalProperties": false,
      "properties": {
        "exposure_copy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "const": "evaluation_exposure",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "exposure_copy"
      ],
      "title": "EvaluationArm",
      "type": "object"
    },
    "EvaluationManipulation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evaluation_exposure",
          "title": "Kind",

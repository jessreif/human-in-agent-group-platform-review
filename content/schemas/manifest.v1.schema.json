{
  "$defs": {
    "AckPolicy": {
      "additionalProperties": false,
      "properties": {
        "probabilities": {
          "additionalProperties": {
            "$ref": "#/$defs/AckProbability"
          },
          "propertyNames": {
            "enum": [
              "JT",
              "PM"
            ]
          },
          "title": "Probabilities",
          "type": "object"
        },
        "prompted_seat": {
          "const": "requesting_seat",
          "title": "Prompted Seat",
          "type": "string"
        },
        "unprompted_seat_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "JT",
              "PM"
            ]
          },
          "title": "Unprompted Seat Weights",
          "type": "object"
        }
      },
      "required": [
        "probabilities",
        "unprompted_seat_weights",
        "prompted_seat"
      ],
      "title": "AckPolicy",
      "type": "object"
    },
    "AckProbability": {
      "additionalProperties": false,
      "properties": {
        "prompted": {
          "maximum": 1,
          "minimum": 0,
          "title": "Prompted",
          "type": "number"
        },
        "unprompted": {
          "maximum": 1,
          "minimum": 0,
          "title": "Unprompted",
          "type": "number"
        }
      },
      "required": [
        "prompted",
        "unprompted"
      ],
      "title": "AckProbability",
      "type": "object"
    },
    "Allocation": {
      "additionalProperties": false,
      "properties": {
        "block_size": {
          "enum": [
            2,
            4,
            6
          ],
          "title": "Block Size",
          "type": "integer"
        },
        "method": {
          "const": "permuted_block",
          "title": "Method",
          "type": "string"
        },
        "rng_stream": {
          "const": "assignment",
          "title": "Rng Stream",
          "type": "string"
        },
        "strata": {
          "items": {
            "enum": [
              "study_key",
              "batch_id"
            ],
            "type": "string"
          },
          "title": "Strata",
          "type": "array"
        }
      },
      "required": [
        "method",
        "block_size",
        "strata",
        "rng_stream"
      ],
      "title": "Allocation",
      "type": "object"
    },
    "ArmSpec": {
      "additionalProperties": false,
      "properties": {
        "allocation_weight": {
          "const": 1,
          "title": "Allocation Weight",
          "type": "integer"
        },
        "arm": {
          "enum": [
            "high",
            "low",
            "eval",
            "control",
            "mixed"
          ],
          "title": "Arm",
          "type": "string"
        },
        "manipulation": {
          "discriminator": {
            "mapping": {
              "evaluation_exposure": "#/$defs/EvaluationArm",
              "pressure_values": "#/$defs/PressureArm"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PressureArm"
            },
            {
              "$ref": "#/$defs/EvaluationArm"
            }
          ],
          "title": "Manipulation"
        }
      },
      "required": [
        "arm",
        "allocation_weight",
        "manipulation"
      ],
      "title": "ArmSpec",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$",
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Assistant": {
      "additionalProperties": false,
      "properties": {
        "fallback": {
          "const": "deterministic_file_summary",
          "title": "Fallback",
          "type": "string"
        },
        "model_change_within_session": {
          "const": false,
          "title": "Model Change Within Session",
          "type": "boolean"
        },
        "prompt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "provider": {
          "enum": [
            "univ_local_unresolved_d05",
            "local_openai_chat",
            "local_openai_chat/gemma4:26b@sha256:5571076f3d70050487b26b341705799e0ab29b808164f90d20d4cf84f699d251"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source_access": {
          "const": "participant_file_at_accepted_request",
          "title": "Source Access",
          "type": "string"
        },
        "validator_version": {
          "enum": [
            "validator.pending_wp10a",
            "teammate_output_v7"
          ],
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "source_access",
        "prompt",
        "validator_version",
        "fallback",
        "model_change_within_session"
      ],
      "title": "Assistant",
      "type": "object"
    },
    "ChannelPhase": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "items": {
            "enum": [
              "file_work",
              "answer_drafting",
              "structured_seeking",
              "sharing",
              "social_reply",
              "assistant_prompting"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Enabled",
          "type": "array"
        },
        "from_active_s": {
          "minimum": 0,
          "title": "From Active S",
          "type": "integer"
        },
        "name": {
          "enum": [
            "task",
            "solo_review"
          ],
          "title": "Name",
          "type": "string"
        },
        "until_active_s": {
          "exclusiveMinimum": 0,
          "title": "Until Active S",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "from_active_s",
        "until_active_s",
        "enabled"
      ],
      "title": "ChannelPhase",
      "type": "object"
    },
    "Channels": {
      "additionalProperties": false,
      "properties": {
        "phases": {
          "items": {
            "$ref": "#/$defs/ChannelPhase"
          },
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        }
      },
      "required": [
        "phases"
      ],
      "title": "Channels",
      "type": "object"
    },
    "Checkin": {
      "additionalProperties": false,
      "properties": {
        "at_active_s": {
          "exclusiveMaximum": 360,
          "minimum": 1,
          "title": "At Active S",
          "type": "integer"
        },
        "collect_wall_ms": {
          "maximum": 30000,
          "minimum": 0,
          "title": "Collect Wall Ms",
          "type": "integer"
        },
        "inactivity_cap_wall_s": {
          "maximum": 600,
          "minimum": 30,
          "title": "Inactivity Cap Wall S",
          "type": "integer"
        },
        "inactivity_outcome": {
          "const": "technical_stop/checkin_incomplete",
          "title": "Inactivity Outcome",
          "type": "string"
        },
        "own_rating_skippable": {
          "title": "Own Rating Skippable",
          "type": "boolean"
        },
        "resume": {
          "const": "explicit",
          "title": "Resume",
          "type": "string"
        }
      },
      "required": [
        "at_active_s",
        "collect_wall_ms",
        "inactivity_cap_wall_s",
        "inactivity_outcome",
        "own_rating_skippable",
        "resume"
      ],
      "title": "Checkin",
      "type": "object"
    },
    "ClassPolicy": {
      "additionalProperties": false,
      "description": "Timing policy for one response class (spec §4.2, §6.3, §6.5).",
      "properties": {
        "delay": {
          "items": {
            "discriminator": {
              "mapping": {
                "fixed": "#/$defs/Fixed",
                "lognormal": "#/$defs/Lognormal"
              },
              "propertyName": "family"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Lognormal"
              },
              {
                "$ref": "#/$defs/Fixed"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Delay",
          "type": "array"
        },
        "fallback": {
          "enum": [
            "deterministic_script",
            "deterministic_file_summary",
            "none"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "floor": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "fixed": "#/$defs/Fixed",
                  "lognormal": "#/$defs/Lognormal"
                },
                "propertyName": "family"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Lognormal"
                },
                {
                  "$ref": "#/$defs/Fixed"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor"
        },
        "mechanism": {
          "enum": [
            "demo_structured_delay_length",
            "demo_social_additive",
            "demo_assistant_floor",
            "concurrent"
          ],
          "title": "Mechanism",
          "type": "string"
        },
        "platform_delay": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "fixed": "#/$defs/Fixed",
                  "lognormal": "#/$defs/Lognormal"
                },
                "propertyName": "family"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Lognormal"
                },
                {
                  "$ref": "#/$defs/Fixed"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Platform Delay"
        },
        "presence_cue": {
          "enum": [
            "none",
            "typing_indicator"
          ],
          "title": "Presence Cue",
          "type": "string"
        },
        "rendering": {
          "const": "complete",
          "title": "Rendering",
          "type": "string"
        },
        "seat_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/SeatOverride"
          },
          "propertyNames": {
            "enum": [
              "JT",
              "PM"
            ]
          },
          "title": "Seat Overrides",
          "type": "object"
        },
        "think": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "fixed": "#/$defs/Fixed",
                  "lognormal": "#/$defs/Lognormal"
                },
                "propertyName": "family"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Lognormal"
                },
                {
                  "$ref": "#/$defs/Fixed"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Think"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Ms"
        },
        "typing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Typing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mechanism",
        "delay",
        "fallback",
        "rendering",
        "presence_cue"
      ],
      "title": "ClassPolicy",
      "type": "object"
    },
    "Concurrency": {
      "additionalProperties": false,
      "properties": {
        "assistant_pending_prompts": {
          "maximum": 10,
          "minimum": 1,
          "title": "Assistant Pending Prompts",
          "type": "integer"
        },
        "over_cap": {
          "const": "reject_visible",
          "title": "Over Cap",
          "type": "string"
        },
        "per_seat_pending_requests": {
          "maximum": 10,
          "minimum": 1,
          "title": "Per Seat Pending Requests",
          "type": "integer"
        }
      },
      "required": [
        "per_seat_pending_requests",
        "assistant_pending_prompts",
        "over_cap"
      ],
      "title": "Concurrency",
      "type": "object"
    },
    "CrosstalkPolicy": {
      "additionalProperties": false,

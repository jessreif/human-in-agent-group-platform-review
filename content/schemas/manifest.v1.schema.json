              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Teammate Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "teammate_values"
      ],
      "title": "PressureArm",
      "type": "object"
    },

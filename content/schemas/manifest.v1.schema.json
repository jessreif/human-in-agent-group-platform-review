            "type": "string"
          },
          "title": "Surfaces",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "surfaces",
        "status"
      ],
      "title": "EvaluationManipulation",
      "type": "object"
    },
    "Fixed": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "fixed",
          "title": "Family",
          "type": "string"
        },
        "seconds": {
          "maximum": 600,
          "minimum": 0,
          "title": "Seconds",
          "type": "number"
        }
      },
      "required": [
        "family",
        "seconds"
      ],
      "title": "Fixed",
      "type": "object"
    },
    "Instruments": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "consent": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "debrief": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "open_ended": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null

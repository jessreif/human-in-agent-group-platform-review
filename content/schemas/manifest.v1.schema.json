            "type": "string"
          },
          "title": "Completion Statuses",
          "type": "array"
        },
        "payment_policy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "ratings_contingent_pay": {
          "const": false,
          "title": "Ratings Contingent Pay",
